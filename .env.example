# --- Branding (single place to rename) ---
SITE_NAME=Path Sarathi
SITE_TAGLINE=For Students to study, with no Worry
SITE_SUBTITLE=Everything for Students to Study
FACULTIES=BSc.CSIT,BIT,BBA,LAW,BITM
# --- Database (Postgres is default per decision) ---
# Example local Postgres:
DATABASE_URL=postgresql+psycopg2://garibi:garibi@localhost:5432/garibi
# Fallback dev SQLite (auto-used if Postgres unreachable and ALLOW_SQLITE_FALLBACK=true):
ALLOW_SQLITE_FALLBACK=true
SQLITE_URL=sqlite:///./garibi_dev.db

# --- Auth ---
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- AI / Ollama ---
# Local Generator default. If Ollama offline, app auto-falls back to local stub.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_DIR=./chroma_db

# --- Storage ---
DATA_DIR=./data
PROMPTS_DIR=./prompts
